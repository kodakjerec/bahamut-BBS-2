<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/content_view">
    <View style="@style/ItemViewDividerHorizontal"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusableInTouchMode="true">
        <Button
            android:id="@+id/BlockList_Reset"
            style="@style/ToolbarItem.Danger"
            android:layout_weight="0"
            android:minHeight="48dp"
            android:minWidth="100dp"
            android:padding="6dp"
            android:text="@string/reset"/>
        <com.kota.Bahamut.pages.model.PostEditText
            android:id="@+id/BlockList_Input"
            style="@style/TextViewLarge"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:autofillHints=""
            android:background="?attr/bahamut_itemBackground"
            android:gravity="center"
            android:hint="@string/please_input_id"
            android:inputType="text"
            android:singleLine="true"/>
        <Button
            android:id="@+id/BlockList_Add"
            style="@style/ToolbarItem.Danger"
            android:layout_weight="0"
            android:minHeight="48dp"
            android:minWidth="100dp"
            android:padding="6dp"
            android:text="@string/add"/>
    </LinearLayout>
    <View style="@style/ItemViewDividerHorizontal"/>
    <View android:background="?attr/bahamut_dividerColor" android:layout_width="match_parent" android:layout_height="5dp"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/BlockList_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:layout_weight="1"/>

    <LinearLayout
        android:id="@+id/toolbar"
        style="@style/toolbar">

        <Button
            android:id="@+id/BlockList_BackButton"
            style="@style/ToolbarItem"
            android:text="@string/_back" />
    </LinearLayout>
</LinearLayout>
