<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/BoardExtendOptionalPage_historyItemView_contentView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View
        android:id="@+id/BoardExtendOptionalPage_historyItemView_DividerTop"
        style="@style/HorizontalDivider"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/BoardExtendOptionalPage_historyItemView_backgroundView"
            style="@style/TouchBlock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/bahamut_pageBackground"
            android:orientation="horizontal">

            <com.kota.telnetUI.textView.TelnetTextViewNormal
                android:id="@+id/BoardExtendOptionalPage_historyItemView_Status"
                style="@style/TextViewNormal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_"
                android:textColor="?attr/bahamut_boardItemStatusColor" />

            <com.kota.telnetUI.textView.TelnetTextViewNormal
                android:id="@+id/BoardExtendOptionalPage_historyItemView_Title"
                style="@style/TextViewNormal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/un_input"
                android:textColor="?attr/bahamut_defaultTextColor" />
        </LinearLayout>

        <!-- 操作按鈕 -->
        <LinearLayout
            android:id="@+id/BoardExtendOptionalPage_historyItemView_ButtonBlock"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:visibility="gone">

            <View style="@style/ToolbarDivider" />

            <Button
                android:id="@+id/BoardExtendOptionalPage_historyItemView_Delete"
                style="@style/ToolbarItem.Danger"
                android:layout_width="60dp"
                android:layout_height="match_parent"
                android:text="@string/delete_short"
                android:textSize="14sp" />
        </LinearLayout>

        <View
            android:id="@+id/BoardExtendOptionalPage_historyItemView_SplitView"
            style="@style/VerticalDivider"
            android:visibility="gone" />

        <include
            android:id="@+id/ListItem_ArrowView"
            layout="@layout/right_arrow_item_view"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:id="@+id/BoardExtendOptionalPage_historyItemView_DividerBottom"
        style="@style/HorizontalDivider" />
</LinearLayout>