<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ToolbarFloating"
    android:layout_width="80dp"
    android:layout_height="180dp"
    android:layout_marginEnd="0dp"
    android:orientation="vertical"
    android:background="?attr/bahamut_dividerColor">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="1dp"
        style="@style/toolbar">
        <Button
            android:id="@+id/ToolbarFloating_setting"
            style="@style/ToolbarItem"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:text="@string/post" />
        <View style="@style/ToolbarDivider.Horizontal" />
        <Button
            android:id="@+id/ToolbarFloating_1"
            style="@style/ToolbarItem"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:text="@string/prev_page" />
        <View style="@style/ToolbarDivider.Horizontal" />
        <Button
            android:id="@+id/ToolbarFloating_2"
            style="@style/ToolbarItem"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:text="@string/last_page" />
    </LinearLayout>
</LinearLayout>