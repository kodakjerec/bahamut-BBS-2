<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/bahamut_pageBackground"
    android:id="@+id/content_view">
    <LinearLayout
        android:id="@+id/Message_Main_Header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="60dp">
            <TextView
                android:id="@+id/Message_Main_Back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                style="@style/TextViewNormal"
                android:text="@string/_back"/>
            <LinearLayout
                android:id="@+id/Message_Main_CheckboxLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">
                <com.kota.telnetUI.textView.TelnetTextViewLarge
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/message_small_show_float"
                    style="@style/TextViewVerySmall"
                    tools:ignore="RelativeOverlap" />
                <CheckBox
                    android:id="@+id/Message_Main_Checkbox"
                    style="@style/CheckboxBahamut"
                    android:layout_gravity="center"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View style="@style/HorizontalDivider" />
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.kota.Bahamut.pages.model.PostEditText
                android:id="@+id/Message_Main_Search"
                style="@style/PostEditTextStyle"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:autofillHints=""
                android:hint="@string/search_id"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLength="12"
                android:textSize="20sp"
                android:imeOptions="actionSearch"
                android:background="?attr/bahamut_pageBackground"
                android:textColor="?attr/bahamut_defaultTextColor"/>
            <TextView
                android:id="@+id/Message_Main_Search_Clear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/message_main_search_clear"
                android:layout_alignParentEnd="true"
                android:layout_centerInParent="true"
                android:textColor="?attr/bahamut_articleContentColor1"
                tools:ignore="RelativeOverlap" />
        </RelativeLayout>
    </LinearLayout>
    <com.kota.asFramework.ui.ASListView
        android:layout_below="@+id/Message_Main_Header"
        android:layout_above="@+id/toolbar_List"
        android:id="@+id/Message_Main_Scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout android:id="@+id/toolbar_List" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_above="@+id/toolbar_container" android:visibility="gone">
        <Button android:text="@string/zero_word" style="@style/ToolbarItem"/>
        <View style="@style/ToolbarDivider"/>
        <Button  android:id="@+id/Message_Main_Button_Prev" android:text="@string/prev_page" style="@style/ToolbarItem"/>
        <View style="@style/ToolbarDivider"/>
        <Button  android:id="@+id/Message_Main_Button_Next" android:text="@string/next_page" style="@style/ToolbarItem"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/toolbar_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_alignParentBottom="true">

        <View style="@style/HorizontalDivider"/>

        <LinearLayout android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="wrap_content">
            <Button android:textColor="?attr/bahamut_tabSelectedTextColor" android:id="@+id/Message_Main_Button_Chat" android:background="?attr/bahamut_tabSelectedBackground" android:text="@string/message_main_tab_chat" style="@style/ToolbarItem"/>
            <View style="@style/ToolbarDivider"/>
            <Button android:textColor="?attr/bahamut_tabUnselectedTextColor" android:id="@+id/Message_Main_Button_List" android:background="?attr/bahamut_tabUnselectedBackground" android:text="@string/message_main_tab_list" style="@style/ToolbarItem"/>
            <View style="@style/ToolbarDivider"/>
            <Button android:textColor="?attr/bahamut_tabUnselectedTextColor" android:id="@+id/Message_Main_Settings" android:background="?attr/bahamut_tabUnselectedBackground" android:text="@string/setting" style="@style/ToolbarItem"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>