<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:background="?attr/bahamut_pageBackground" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/BaseTouchPart">
        <com.kota.telnetUI.textView.TelnetTextViewLarge
            android:gravity="center_vertical"
            android:id="@+id/BlockListItemView_Name"
            android:padding="10dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_weight="1"
            style="@style/TextViewLarge"/>
        <Button
            android:id="@+id/BlockListItemView_Delete"
            style="@style/ToolbarItem.Danger"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="0"
            android:minWidth="100dp"
            android:minHeight="48dp"
            android:padding="6dp"
            android:text="@string/delete"/>
    </LinearLayout>
    <View android:id="@+id/BlockListPage_ItemView_DividerBottom" style="@style/HorizontalDivider"/>
</LinearLayout>
