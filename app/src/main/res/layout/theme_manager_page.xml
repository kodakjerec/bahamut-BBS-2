<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/bahamut_pageBackground"
    android:orientation="vertical">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/toolbar"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/content_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <!-- 頂端主題選擇分頁 -->
        <LinearLayout
            android:id="@+id/Theme_Manager_Page_Buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/Theme_Manager_Page_Button_0" style="@style/ToolbarItem" android:layout_width="wrap_content" android:layout_weight="1" android:text="@string/number_0" />
            <Button android:id="@+id/Theme_Manager_Page_Button_1" style="@style/ToolbarItem" android:layout_width="wrap_content" android:layout_weight="1" android:text="@string/number_1" />
            <Button android:id="@+id/Theme_Manager_Page_Button_2" style="@style/ToolbarItem" android:layout_width="wrap_content" android:layout_weight="1" android:text="@string/number_2" />
            <Button android:id="@+id/Theme_Manager_Page_Button_3" style="@style/ToolbarItem" android:layout_width="wrap_content" android:layout_weight="1" android:text="@string/number_3" />
            <Button android:id="@+id/Theme_Manager_Page_Button_4" style="@style/ToolbarItem" android:layout_width="wrap_content" android:layout_weight="1" android:text="@string/number_4" />
        </LinearLayout>

        <!-- 名稱設定 -->
        <LinearLayout
            style="@style/TouchBlock"
            android:layout_width="match_parent"
            android:layout_height="60dp">
            <com.kota.telnetUI.textView.TelnetTextViewUltraLarge
                style="@style/TextViewUltraLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:text="@string/theme_manager_page_group0" />
            <com.kota.Bahamut.pages.model.PostEditText
                android:id="@+id/Theme_Manager_Page_Toolbar_Name"
                style="@style/EditTextSingleLine"
                android:hint="@string/Username_hint"
                android:textSize="28sp" />
        </LinearLayout>

        <!-- 工具列按鈕設定區 -->
        <com.kota.telnetUI.textView.TelnetTextView
            style="@style/SystemSettingsChapter"
            android:text="@string/theme_manager_page_group1"/>

        <!-- 一般按鈕範例 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <com.kota.telnetUI.textView.TelnetTextView style="@style/TextViewSmall" android:layout_width="40dp" android:layout_height="wrap_content" android:layout_gravity="center" android:text="範例" />
            <Button android:id="@+id/Theme_Manager_Page_Toolbar_Sample_2" style="@style/ToolbarItem" android:layout_weight="1" android:text="@string/theme_manager_page_chapter2" />
            <Button android:id="@+id/Theme_Manager_Page_Toolbar_Sample_1" style="@style/ToolbarItem" android:layout_weight="1" android:text="@string/theme_manager_page_chapter1" />
            <Button android:id="@+id/Theme_Manager_Page_Toolbar_Sample_3" style="@style/ToolbarItem" android:layout_weight="1" android:text="@string/theme_manager_page_chapter3" />
        </LinearLayout>

        <!-- 工具列文字/背景色選擇 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <com.kota.telnetUI.textView.TelnetTextView style="@style/TextViewSmall" android:layout_width="40dp" android:layout_height="wrap_content" android:layout_gravity="center" android:text="@string/theme_manager_page_chapter_text" />
            <com.kota.telnetUI.textView.TelnetTextView android:id="@+id/Theme_Manager_Page_Text_Color_Pressed" style="@style/TextViewNormal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="50dp" android:gravity="center" />
            <com.kota.telnetUI.textView.TelnetTextView android:id="@+id/Theme_Manager_Page_Text_Color" style="@style/TextViewNormal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="50dp" android:gravity="center" />
            <com.kota.telnetUI.textView.TelnetTextView android:id="@+id/Theme_Manager_Page_Text_Color_Disabled" style="@style/TextViewNormal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="50dp" android:gravity="center" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <com.kota.telnetUI.textView.TelnetTextView style="@style/TextViewSmall" android:layout_width="40dp" android:layout_height="wrap_content" android:layout_gravity="center" android:text="@string/theme_manager_page_chapter_back" />
            <com.kota.telnetUI.textView.TelnetTextView android:id="@+id/Theme_Manager_Page_Back_Color_Pressed" style="@style/TextViewNormal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="50dp" android:gravity="center" />
            <com.kota.telnetUI.textView.TelnetTextView android:id="@+id/Theme_Manager_Page_Back_Color" style="@style/TextViewNormal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="50dp" android:gravity="center" />
            <com.kota.telnetUI.textView.TelnetTextView android:id="@+id/Theme_Manager_Page_Back_Color_Disabled" style="@style/TextViewNormal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="50dp" android:gravity="center" />
        </LinearLayout>

        <!-- Danger 按鈕範例 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <com.kota.telnetUI.textView.TelnetTextView style="@style/TextViewSmall" android:layout_width="40dp" android:layout_height="wrap_content" android:layout_gravity="center" android:text="警示" />
            <Button android:id="@+id/Theme_Manager_Page_Toolbar_Sample_Danger_2" style="@style/ToolbarItem.Danger" android:layout_weight="1" android:text="@string/theme_manager_page_chapter2" />
            <Button android:id="@+id/Theme_Manager_Page_Toolbar_Sample_Danger_1" style="@style/ToolbarItem.Danger" android:layout_weight="1" android:text="@string/theme_manager_page_chapter1" />
            <Button android:id="@+id/Theme_Manager_Page_Toolbar_Sample_Danger_3" style="@style/ToolbarItem.Danger" android:layout_weight="1" android:text="@string/theme_manager_page_chapter3" />
        </LinearLayout>

        <!-- Danger 工具列文字/背景色選擇 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <com.kota.telnetUI.textView.TelnetTextView style="@style/TextViewSmall" android:layout_width="40dp" android:layout_height="wrap_content" android:layout_gravity="center" android:text="@string/theme_manager_page_chapter_text" />
            <com.kota.telnetUI.textView.TelnetTextView android:id="@+id/Theme_Manager_Page_Text_Color_Danger_Pressed" style="@style/TextViewNormal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="50dp" android:gravity="center" />
            <com.kota.telnetUI.textView.TelnetTextView android:id="@+id/Theme_Manager_Page_Text_Color_Danger" style="@style/TextViewNormal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="50dp" android:gravity="center" />
            <com.kota.telnetUI.textView.TelnetTextView android:id="@+id/Theme_Manager_Page_Text_Color_Danger_Disabled" style="@style/TextViewNormal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="50dp" android:gravity="center" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <com.kota.telnetUI.textView.TelnetTextView style="@style/TextViewSmall" android:layout_width="40dp" android:layout_height="wrap_content" android:layout_gravity="center" android:text="@string/theme_manager_page_chapter_back" />
            <com.kota.telnetUI.textView.TelnetTextView android:id="@+id/Theme_Manager_Page_Back_Color_Danger_Pressed" style="@style/TextViewNormal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="50dp" android:gravity="center" />
            <com.kota.telnetUI.textView.TelnetTextView android:id="@+id/Theme_Manager_Page_Back_Color_Danger" style="@style/TextViewNormal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="50dp" android:gravity="center" />
            <com.kota.telnetUI.textView.TelnetTextView android:id="@+id/Theme_Manager_Page_Back_Color_Danger_Disabled" style="@style/TextViewNormal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="50dp" android:gravity="center" />
        </LinearLayout>


        <!-- 標題列設定 -->
        <com.kota.telnetUI.textView.TelnetTextView style="@style/SystemSettingsChapter" android:text="標題列 (Header)" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <com.kota.telnetUI.textView.TelnetTextView style="@style/TextViewSmall" android:layout_width="40dp" android:layout_height="wrap_content" android:layout_gravity="center" android:text="範例" />
            <com.kota.telnetUI.textView.TelnetTextView style="@style/TextViewNormal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="30dp" android:gravity="center" android:text="背景" />
            <com.kota.telnetUI.textView.TelnetTextView style="@style/TextViewNormal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="30dp" android:gravity="center" android:text="標題" />
            <com.kota.telnetUI.textView.TelnetTextView style="@style/TextViewNormal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="30dp" android:gravity="center" android:text="版主" />
            <com.kota.telnetUI.textView.TelnetTextView style="@style/TextViewNormal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="30dp" android:gravity="center" android:text="版面" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <View android:layout_width="40dp" android:layout_height="0dp" />
            <com.kota.telnetUI.textView.TelnetTextView android:id="@+id/Theme_Manager_Page_Header_Back_Color" style="@style/TextViewNormal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="60dp" android:gravity="center" />
            <com.kota.telnetUI.textView.TelnetTextView android:id="@+id/Theme_Manager_Page_Header_Header_Color" style="@style/TextViewNormal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="60dp" android:gravity="center" />
            <com.kota.telnetUI.textView.TelnetTextView android:id="@+id/Theme_Manager_Page_Header_Manager_Color" style="@style/TextViewNormal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="60dp" android:gravity="center" />
            <com.kota.telnetUI.textView.TelnetTextView android:id="@+id/Theme_Manager_Page_Header_Border_Color" style="@style/TextViewNormal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="60dp" android:gravity="center" />
        </LinearLayout>

        <!-- 內文設定 -->
        <com.kota.telnetUI.textView.TelnetTextView style="@style/SystemSettingsChapter" android:text="內文 (Content)" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <com.kota.telnetUI.textView.TelnetTextView style="@style/TextViewSmall" android:layout_width="40dp" android:layout_height="wrap_content" android:layout_gravity="center" android:text="範例" />
            <com.kota.telnetUI.textView.TelnetTextView style="@style/TextViewNormal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="30dp" android:gravity="center" android:text="背景" />
            <com.kota.telnetUI.textView.TelnetTextView style="@style/TextViewNormal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="30dp" android:gravity="center" android:text="作者" />
            <com.kota.telnetUI.textView.TelnetTextView style="@style/TextViewNormal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="30dp" android:gravity="center" android:text="內文" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <View android:layout_width="40dp" android:layout_height="0dp" />
            <com.kota.telnetUI.textView.TelnetTextView android:id="@+id/Theme_Manager_Page_Content_Back_Color" style="@style/TextViewNormal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="60dp" android:gravity="center"/>
            <com.kota.telnetUI.textView.TelnetTextView android:id="@+id/Theme_Manager_Page_Content_Author_Color" style="@style/TextViewNormal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="60dp" android:gravity="center"/>
            <com.kota.telnetUI.textView.TelnetTextView android:id="@+id/Theme_Manager_Page_Content_Color" style="@style/TextViewNormal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="60dp" android:gravity="center"/>
        </LinearLayout>

        <!-- 引用設定 -->
        <com.kota.telnetUI.textView.TelnetTextView style="@style/SystemSettingsChapter" android:text="引用 (Quote)" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <com.kota.telnetUI.textView.TelnetTextView style="@style/TextViewSmall" android:layout_width="40dp" android:layout_height="wrap_content" android:layout_gravity="center" android:text="範例" />
            <com.kota.telnetUI.textView.TelnetTextView style="@style/TextViewNormal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="30dp" android:gravity="center" android:text="背景" />
            <com.kota.telnetUI.textView.TelnetTextView style="@style/TextViewNormal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="30dp" android:gravity="center" android:text="作者" />
            <com.kota.telnetUI.textView.TelnetTextView style="@style/TextViewNormal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="30dp" android:gravity="center" android:text="內文" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <View android:layout_width="40dp" android:layout_height="0dp" />
            <com.kota.telnetUI.textView.TelnetTextView android:id="@+id/Theme_Manager_Page_Quote_Back_Color" style="@style/TextViewNormal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="60dp" android:gravity="center"/>
            <com.kota.telnetUI.textView.TelnetTextView android:id="@+id/Theme_Manager_Page_Quote_Author_Color" style="@style/TextViewNormal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="60dp" android:gravity="center"/>
            <com.kota.telnetUI.textView.TelnetTextView android:id="@+id/Theme_Manager_Page_Quote_Color" style="@style/TextViewNormal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="60dp" android:gravity="center"/>
        </LinearLayout>

        <!-- 看板列表設定 -->
        <com.kota.telnetUI.textView.TelnetTextView style="@style/SystemSettingsChapter" android:text="看板列表 (List)" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <com.kota.telnetUI.textView.TelnetTextView style="@style/TextViewSmall" android:layout_width="40dp" android:layout_height="wrap_content" android:layout_gravity="center" android:text="範例1" />
            <com.kota.telnetUI.textView.TelnetTextView style="@style/TextViewNormal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="30dp" android:gravity="center" android:text="背景" />
            <com.kota.telnetUI.textView.TelnetTextView style="@style/TextViewNormal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="30dp" android:gravity="center" android:text="標題" />
            <com.kota.telnetUI.textView.TelnetTextView style="@style/TextViewNormal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="30dp" android:gravity="center" android:text="已讀" />
            <com.kota.telnetUI.textView.TelnetTextView style="@style/TextViewNormal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="30dp" android:gravity="center" android:text="分隔線" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <View android:layout_width="40dp" android:layout_height="0dp" />
            <com.kota.telnetUI.textView.TelnetTextView
                android:id="@+id/Theme_Manager_Page_List_Back_Color"
                style="@style/TextViewNormal"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="50dp"
                android:gravity="center" />
            <com.kota.telnetUI.textView.TelnetTextView
                android:id="@+id/Theme_Manager_Page_List_Title_Color"
                style="@style/TextViewNormal"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="50dp"
                android:gravity="center" />
            <com.kota.telnetUI.textView.TelnetTextView
                android:id="@+id/Theme_Manager_Page_List_Title_Read_Color"
                style="@style/TextViewNormal"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="50dp"
                android:gravity="center" />
            <com.kota.telnetUI.textView.TelnetTextView
                android:id="@+id/Theme_Manager_Page_List_Divider_Color"
                style="@style/TextViewNormal"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="50dp"
                android:gravity="center" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <com.kota.telnetUI.textView.TelnetTextView style="@style/TextViewSmall" android:layout_width="40dp" android:layout_height="wrap_content" android:layout_gravity="center" android:text="範例2" />
            <com.kota.telnetUI.textView.TelnetTextView style="@style/TextViewNormal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="30dp" android:gravity="center" android:text="關注首" />
            <com.kota.telnetUI.textView.TelnetTextView style="@style/TextViewNormal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="30dp" android:gravity="center" android:text="關注讀" />
            <com.kota.telnetUI.textView.TelnetTextView style="@style/TextViewNormal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="30dp" android:gravity="center" android:text="關注回" />
            <com.kota.telnetUI.textView.TelnetTextView style="@style/TextViewNormal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="30dp" android:gravity="center" android:text="關注回讀" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <View android:layout_width="40dp" android:layout_height="0dp" />
            <com.kota.telnetUI.textView.TelnetTextView
                android:id="@+id/Theme_Manager_Page_List_Title_Follow_First_Color"
                style="@style/TextViewNormal"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="50dp"
                android:gravity="center" />
            <com.kota.telnetUI.textView.TelnetTextView
                android:id="@+id/Theme_Manager_Page_List_Title_Follow_First_Read_Color"
                style="@style/TextViewNormal"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="50dp"
                android:gravity="center" />
            <com.kota.telnetUI.textView.TelnetTextView
                android:id="@+id/Theme_Manager_Page_List_Title_Follow_Color"
                style="@style/TextViewNormal"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="50dp"
                android:gravity="center" />
            <com.kota.telnetUI.textView.TelnetTextView
                android:id="@+id/Theme_Manager_Page_List_Title_Follow_Read_Color"
                style="@style/TextViewNormal"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="50dp"
                android:gravity="center" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <com.kota.telnetUI.textView.TelnetTextView style="@style/TextViewSmall" android:layout_width="40dp" android:layout_height="wrap_content" android:layout_gravity="center" android:text="範例3" />
            <com.kota.telnetUI.textView.TelnetTextView style="@style/TextViewNormal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="30dp" android:gravity="center" android:text="編號" />
            <com.kota.telnetUI.textView.TelnetTextView style="@style/TextViewNormal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="30dp" android:gravity="center" android:text="日期" />
            <com.kota.telnetUI.textView.TelnetTextView style="@style/TextViewNormal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="30dp" android:gravity="center" android:text="作者" />
            <com.kota.telnetUI.textView.TelnetTextView style="@style/TextViewNormal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="30dp" android:gravity="center" android:text="M文" />
            <com.kota.telnetUI.textView.TelnetTextView style="@style/TextViewNormal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="30dp" android:gravity="center" android:text="狀態" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <View android:layout_width="40dp" android:layout_height="0dp" />
            <com.kota.telnetUI.textView.TelnetTextView
                android:id="@+id/Theme_Manager_Page_List_Number_Color"
                style="@style/TextViewNormal"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="50dp"
                android:gravity="center" />
            <com.kota.telnetUI.textView.TelnetTextView
                android:id="@+id/Theme_Manager_Page_List_Date_Color"
                style="@style/TextViewNormal"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="50dp"
                android:gravity="center" />
            <com.kota.telnetUI.textView.TelnetTextView
                android:id="@+id/Theme_Manager_Page_List_Author_Color"
                style="@style/TextViewNormal"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="50dp"
                android:gravity="center" />
            <com.kota.telnetUI.textView.TelnetTextView
                android:id="@+id/Theme_Manager_Page_List_Mark_Color"
                style="@style/TextViewNormal"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="50dp"
                android:gravity="center" />
            <com.kota.telnetUI.textView.TelnetTextView
                android:id="@+id/Theme_Manager_Page_List_Status_Color"
                style="@style/TextViewNormal"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="50dp"
                android:gravity="center" />
        </LinearLayout>

        <!-- 工具列按鈕 -->
        <LinearLayout
            android:id="@+id/Theme_Manager_Page_Edit_Toolbar"
            style="@style/toolbar">
            <Button android:id="@+id/Theme_Manager_Page_Toolbar_Reset" style="@style/ToolbarItem.Danger" android:layout_weight="0" android:text="@string/reset" />
            <Button android:id="@+id/Theme_Manager_Page_Toolbar_Update" style="@style/ToolbarItem" android:layout_width="wrap_content" android:layout_weight="1" android:visibility="gone" android:text="@string/theme_manager_page_chapter_update" />
        </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 畫面底部固定導覽列 -->
    <LinearLayout
        android:id="@+id/toolbar"
        style="@style/toolbar"
        android:layout_alignParentBottom="true">
        <Button android:id="@+id/Theme_Manager_Page_Toolbar_Back" style="@style/ToolbarItem" android:layout_weight="1" android:text="@string/_back" />
    </LinearLayout>
</RelativeLayout>