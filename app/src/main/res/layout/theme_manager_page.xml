<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/bahamut_pageBackground"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/toolbar_container"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/content_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 頂端主題選擇分頁 -->
            <LinearLayout
                android:id="@+id/Theme_Manager_Page_Buttons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button android:id="@+id/Theme_Manager_Page_Button_0" style="@style/ToolbarItem" android:layout_width="wrap_content" android:layout_weight="1" />
                <Button android:id="@+id/Theme_Manager_Page_Button_1" style="@style/ToolbarItem" android:layout_width="wrap_content" android:layout_weight="1" />
                <Button android:id="@+id/Theme_Manager_Page_Button_2" style="@style/ToolbarItem" android:layout_width="wrap_content" android:layout_weight="1" />
                <Button android:id="@+id/Theme_Manager_Page_Button_3" style="@style/ToolbarItem" android:layout_width="wrap_content" android:layout_weight="1" />
                <Button android:id="@+id/Theme_Manager_Page_Button_4" style="@style/ToolbarItem" android:layout_width="wrap_content" android:layout_weight="1" />
            </LinearLayout>

            <com.kota.telnetUI.textView.TelnetTextView
                style="@style/TextViewNormal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="20dp"
                android:text="@string/theme_manager_page_guide" />

        </LinearLayout>
    </ScrollView>

    <!-- 畫面底部固定導覽列 -->
    <LinearLayout
        android:id="@+id/toolbar_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_alignParentBottom="true">

        <View style="@style/HorizontalDivider" />

        <LinearLayout
            android:id="@+id/toolbar"
            style="@style/toolbar">
            <Button android:id="@+id/Theme_Manager_Page_Toolbar_Back" style="@style/ToolbarItem" android:layout_weight="1" android:text="@string/_back" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>