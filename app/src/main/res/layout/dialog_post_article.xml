<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="?attr/bahamut_dialogBorderColor"
    android:padding="3dp"
    android:layout_width="260dp"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:background="?attr/bahamut_pageBackground"
        android:padding="1dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.kota.telnetUI.textView.TelnetTextViewLarge
            android:textColor="?attr/bahamut_dialogTitleTextColor"
            android:background="?attr/bahamut_dialogTitleBackground"
            android:padding="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/confirm"
            style="@style/TextViewLarge"/>
        <View style="@style/HorizontalDivider" />
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/bahamut_itemBackground"
                android:orientation="vertical">

                <com.kota.telnetUI.textView.TelnetTextViewNormal
                    style="@style/TextViewNormal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/is_post_article"
                    android:textColor="?attr/bahamut_defaultTextColor" />

                <LinearLayout
                    android:id="@+id/reply_target_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical">

                    <com.kota.telnetUI.textView.TelnetTextViewNormal
                        style="@style/TextViewNormal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/is_post_article_reply"
                        android:textColor="?attr/bahamut_defaultTextColor" />

                    <RadioGroup
                        android:id="@+id/post_target"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <RadioButton
                            android:id="@+id/post_to_board"
                            style="@style/ListDialogItem"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_weight="1"
                            android:checked="true"
                            android:paddingStart="10dp"
                            android:paddingEnd="0dp"
                            android:text="@string/post_to_board"
                            android:textSize="20sp" />

                        <RadioButton
                            android:id="@+id/post_to_mail"
                            style="@style/ListDialogItem"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:paddingStart="10dp"
                            android:paddingEnd="0dp"
                            android:text="@string/post_to_mail"
                            android:textSize="20sp" />

                        <RadioButton
                            android:id="@+id/post_to_both"
                            style="@style/ListDialogItem"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:paddingStart="10dp"
                            android:paddingEnd="0dp"
                            android:text="@string/post_to_both"
                            android:textSize="20sp" />
                    </RadioGroup>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/sign_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical">

                    <com.kota.telnetUI.textView.TelnetTextViewNormal
                        style="@style/TextViewNormal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/select_sign"
                        android:textColor="?attr/bahamut_defaultTextColor" />

                    <Spinner
                        android:id="@+id/sign_spinner"
                        style="@style/SpinnerStyle" />
                </LinearLayout>

                <View style="@style/BlockDividerHorizontal" />

                <LinearLayout android:id="@+id/toolbar" style="@style/toolbar">

                    <Button
                        android:id="@+id/cancel"
                        style="@style/DialogToolbarItem"
                        android:text="@string/cancel" />

                    <View style="@style/ToolbarDivider" />

                    <Button
                        android:id="@+id/send"
                        style="@style/DialogToolbarItem"
                        android:text="@string/send" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
