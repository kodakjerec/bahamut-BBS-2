<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/ClassPage_ItemView_backgroundView"
            style="@style/TouchBlock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/bahamut_pageBackground"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.kota.telnetUI.textView.TelnetTextViewNormal
                    android:id="@+id/ClassPage_ItemView_classTitle"
                    style="@style/TextViewNormal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:singleLine="false"
                    android:textColor="?attr/bahamut_defaultTextColor" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.kota.telnetUI.textView.TelnetTextViewSmall
                    android:id="@+id/ClassPage_ItemView_className"
                    style="@style/TextViewSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/bahamut_classItemNameColor" />

                <com.kota.telnetUI.textView.TelnetTextViewSmall
                    android:id="@+id/ClassPage_ItemView_classManager"
                    style="@style/TextViewSmall"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="right"
                    android:paddingLeft="12dp"
                    android:singleLine="true"
                    android:textColor="?attr/bahamut_classItemManagerColor" />
            </LinearLayout>
        </LinearLayout>

        <View style="@style/VerticalDivider" />

        <include
            android:id="@+id/ListItem_ArrowView"
            layout="@layout/right_arrow_item_view" />

        <Button
            android:id="@+id/ClassPage_ItemView_DeleteButton"
            style="@style/ToolbarItem.Danger"
            android:layout_width="60dp"
            android:layout_height="match_parent"
            android:layout_weight="0"
            android:autoSizeTextType="none"
            android:text="@string/delete_short"
            android:textSize="14sp"
            android:visibility="gone" />

    </LinearLayout>

    <View
        android:id="@+id/ClassPage_ItemView_DividerBottom"
        style="@style/HorizontalDivider" />
</LinearLayout>
