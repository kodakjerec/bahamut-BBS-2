<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ClassPage_ItemView_contentView"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:orientation="vertical" android:id="@+id/ClassPage_ItemView_backgroundView" android:background="?attr/bahamut_listDialogItemBackground" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" style="@style/TouchBlock">
            <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
                <com.kota.telnetUI.textView.TelnetTextViewNormal
                    android:textColor="?attr/bahamut_defaultTextColor" android:ellipsize="end" android:id="@+id/ClassPage_ItemView_classTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:singleLine="false" android:layout_weight="1" style="@style/TextViewNormal"/>
            </LinearLayout>
            <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
                <com.kota.telnetUI.textView.TelnetTextViewSmall
                    android:textColor="?attr/bahamut_classItemNameColor" android:id="@+id/ClassPage_ItemView_className" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/TextViewSmall"/>
                <com.kota.telnetUI.textView.TelnetTextViewSmall
                    android:textColor="?attr/bahamut_classItemManagerColor" android:gravity="right" android:id="@+id/ClassPage_ItemView_classManager" android:paddingLeft="12dp" android:layout_width="0dp" android:layout_height="wrap_content" android:singleLine="true" android:layout_weight="1" style="@style/TextViewSmall"/>
            </LinearLayout>
        </LinearLayout>
        <View style="@style/VerticalDivider"/>
        <include
            layout="@layout/right_arrow_item_view"
            android:id="@+id/ListItem_ArrowView" />
        <ImageView
            android:id="@+id/ClassPage_ItemView_DragHandle"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_vertical"
            android:contentDescription="拖曳排序"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_drag_handle"
            android:visibility="gone" />
    </LinearLayout>
    <View android:id="@+id/ClassPage_ItemView_DividerBottom" style="@style/HorizontalDivider"/>
</LinearLayout>
