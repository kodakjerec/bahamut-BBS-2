<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/BoardPage_ItemView_contentView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:orientation="vertical" android:id="@+id/BoardPage_ItemView_backgroundView" android:background="?attr/bahamut_pageBackground" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" style="@style/TouchBlock">
            <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
                <com.kota.telnetUI.textView.TelnetTextViewNormal
                    android:textColor="?attr/bahamut_boardItemStatusColor" android:layout_gravity="start|center_vertical|center_horizontal|center" android:id="@+id/BoardPage_ItemView_Status" android:layout_width="30dp" android:layout_height="wrap_content" style="@style/TextViewNormal"/>
                <com.kota.telnetUI.textView.TelnetTextViewNormal
                    android:ellipsize="end" android:id="@+id/BoardPage_ItemView_Title" android:layout_width="0dp" android:layout_height="wrap_content" android:singleLine="false" android:layout_weight="1" style="@style/TextViewNormal"/>
            </LinearLayout>
            <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
                <com.kota.telnetUI.textView.TelnetTextViewSmall
                    android:textColor="?attr/bahamut_boardItemNumberColor" android:id="@+id/BoardPage_ItemView_Number" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/TextViewSmall"/>
                <com.kota.telnetUI.textView.TelnetTextViewSmall
                    android:textColor="?attr/bahamut_boardItemMarkColor" android:id="@+id/BoardPage_ItemView_mark" android:paddingStart="12dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/word_m" style="@style/TextViewSmall"/>
                <com.kota.telnetUI.textView.TelnetTextViewSmall
                    android:textColor="?attr/bahamut_boardItemDateColor" android:id="@+id/BoardPage_ItemView_Date" android:paddingStart="12dp" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/TextViewSmall"/>
                <com.kota.telnetUI.textView.TelnetTextViewSmall
                    android:textColor="?attr/bahamut_articleContentColor0" android:id="@+id/BoardPage_ItemView_GY_Title" android:paddingStart="12dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/gy_" style="@style/TextViewSmall"/>
                <com.kota.telnetUI.textView.TelnetTextViewSmall
                    android:textColor="?attr/bahamut_boardItemGyColor" android:id="@+id/BoardPage_ItemView_GY" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/TextViewSmall"/>
                <com.kota.telnetUI.textView.TelnetTextViewSmall
                    android:textColor="?attr/bahamut_boardItemAuthorColor" android:gravity="end" android:id="@+id/BoardPage_ItemView_Author" android:paddingStart="12dp" android:layout_width="0dp" android:layout_height="wrap_content" android:singleLine="true" android:layout_weight="1" style="@style/TextViewSmall"/>
            </LinearLayout>
        </LinearLayout>
        <View style="@style/ToolbarDivider"/>
        <include
            layout="@layout/right_arrow_item_view"
            android:id="@+id/ListItem_ArrowView" />
    </LinearLayout>
    <View android:id="@+id/BoardPage_ItemView_DividerBottom" style="@style/ItemViewDividerHorizontal"/>
</LinearLayout>
