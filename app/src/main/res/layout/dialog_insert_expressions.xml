<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialog_insert_expressions_main_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/bahamut_dialogBorderColor"
    android:orientation="vertical"
    android:padding="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/bahamut_pageBackground"
        android:orientation="vertical">

        <!-- Header -->
        <RelativeLayout
            android:id="@+id/dialog_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/bahamut_dialogTitleBackground">

            <com.kota.telnetUI.textView.TelnetTextViewLarge
                android:id="@+id/dialog_insert_expressions_title"
                style="@style/TextViewLarge"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:paddingStart="6dp"
                android:paddingEnd="66dp"
                android:background="?attr/bahamut_dialogTitleBackground"
                android:textColor="?attr/bahamut_dialogTitleTextColor" />

            <Button
                android:id="@+id/dialog_insert_expressions_setting"
                style="@style/ToolbarItem"
                android:layout_width="60dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:text="@string/setting"
                android:textSize="18sp" />
        </RelativeLayout>

        <View style="@style/HorizontalDivider" />

        <!-- Middle Content -->
        <ScrollView
            android:id="@+id/dialog_insert_expressions_scrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="?attr/bahamut_pageBackground">

            <LinearLayout
                android:id="@+id/dialog_insert_expressions_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical" />
        </ScrollView>

        <View style="@style/ToolbarDivider.Horizontal" />

        <!-- Footer Toolbar -->
        <LinearLayout
            android:id="@+id/dialog_toolbar"
            style="@style/toolbar">

            <Button
                android:id="@+id/cancel"
                style="@style/DialogToolbarItem"
                android:text="@string/cancel" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
