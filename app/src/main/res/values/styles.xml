        <item name="bahamut_boardItemFollowFirstReadColor">@color/board_item_follow_first_read</item>
        <item name="bahamut_boardItemFollowOtherColor">@color/board_item_follow_other</item>
        <item name="bahamut_boardItemFollowOtherReadColor">@color/board_item_follow_other_read</item>
        <item name="bahamut_boardItemNormalColor">@color/board_item_normal</item>
        <item name="bahamut_boardItemNormalReadColor">@color/board_item_normal_read</item>

