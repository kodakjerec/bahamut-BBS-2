        <item name="bahamut_dialogSelectArticleItemBackground">@drawable/dialog_select_article_item_background_color</item>

        <!-- 其他通用 -->
        <item name="bahamut_dialogBorderColor">@color/halfWhite</item>
        <item name="bahamut_pageBackground">@color/page_background</item>

        <!-- 文章內文配色預設值 -->
