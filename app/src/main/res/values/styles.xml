        <item name="android:textColorHint">@color/halfWhite</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>

        <!-- 自定義主題色彩屬性 -->
        <item name="bahamut_titleBarBackground">#FF000060</item>
        <item name="bahamut_toolbarDivider">@color/page_background</item>
        <item name="bahamut_buttonTextColor">@color/button_text_color</item>
        <item name="bahamut_buttonDangerTextColor">@color/board_item_normal</item>
        <item name="bahamut_toolbarItemBackground">@drawable/toolbar_item_background_color</item>
        <item name="bahamut_buttonDangerBackground">@drawable/button_background_1</item>
        <item name="bahamut_dialogItemBackground">@drawable/dialog_item_background_color</item>
        <item name="bahamut_editTextColor">@color/input_box_text</item>
        <item name="bahamut_editTextBackground">@color/input_box_background</item>
        <item name="bahamut_dividerColor">@color/divider_color</item>
        <item name="bahamut_listItemHorizontalDivider">#404040</item>
        <item name="bahamut_listItemVerticalDivider">@color/transparent</item>
        <item name="bahamut_defaultTextColor">@color/board_item_normal</item>
        <item name="bahamut_itemBackground">@color/transparent</item>
        <item name="bahamut_chapterBackground">@color/chapter_background</item>
        <item name="bahamut_chapterTextColor">@color/gray_white</item>
        <item name="bahamut_checkboxTint">@color/button_checkbox</item>
        <item name="bahamut_sliderActiveColor">#FF99CC00</item>
        <item name="bahamut_sliderInactiveColor">#3399CC00</item>
        <item name="bahamut_sliderThumbColor">#FF99CC00</item>

        <!-- board title bar -->
        <item name="bahamut_titleBarMenuIconBackground">#FF101090</item>
        <item name="bahamut_titleBarTitleColor">@color/board_item_follow_other</item>
        <item name="bahamut_titleBarDetailColor">@color/board_item_normal</item>
        <item name="bahamut_titleBarDetail2Color">@color/article_page_header_board</item>

        <!-- 看板分類列表項目 (ClassPageItem) 配色 -->
