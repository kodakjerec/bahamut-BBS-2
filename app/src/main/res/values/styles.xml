<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="BaseTouchPart">
        <item name="android:minWidth">60dp</item>
        <item name="android:minHeight">60dp</item>
    </style>

    <style name="MyTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- 基礎視窗設定 -->
        <item name="android:windowBackground">?attr/bahamut_pageBackground</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:textColorHint">@android:color/tab_indicator_text</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>

        <!-- 自定義主題色彩屬性 -->
        <item name="bahamut_titleBarBackground">#FF000060</item>
        <item name="bahamut_toolbarDivider">@color/black</item>
        <item name="bahamut_buttonTextColor">@color/button_text_color</item>
        <item name="bahamut_toolbarItemBackground">@drawable/toolbar_item_background_color</item>
        <item name="bahamut_dialogItemBackground">@drawable/dialog_item_background_color</item>
        <item name="bahamut_editTextColor">@color/black</item>
        <item name="bahamut_editTextBackground">#FFE0E0E0</item>
        <item name="bahamut_dividerColor">#FF404040</item>
        <item name="bahamut_listItemHorizontalDivider">#404040</item>
        <item name="bahamut_listItemVerticalDivider">@color/transparent</item>
        <item name="bahamut_defaultTextColor">@color/white</item>
        <item name="bahamut_itemBackground">@color/transparent</item>
        <item name="bahamut_chapterBackground">#FF202020</item>
        <item name="bahamut_chapterTextColor">#FFC0C0C0</item>
        <item name="bahamut_checkboxTint">@color/button_checkbox</item>
        <item name="bahamut_sliderActiveColor">#FF99CC00</item>
        <item name="bahamut_sliderInactiveColor">#3399CC00</item>
        <item name="bahamut_sliderThumbColor">#FF99CC00</item>

        <item name="bahamut_titleBarMenuIconBackground">#FF101090</item>

        <!-- 選擇文章對話框相關 -->
        <item name="bahamut_dialogSelectArticleFocusedColor">#FF606060</item>
        <item name="bahamut_dialogSelectArticleDividerColor">#80000000</item>
        <item name="bahamut_dialogSelectArticleTextColor">@color/dialog_select_article_item_text_color</item>
        <item name="bahamut_dialogSelectArticleItemBackground">@drawable/dialog_select_article_item_background_color</item>

        <!-- 其他通用 -->
        <item name="bahamut_dialogBorderColor">@color/halfWhite</item>
        <item name="bahamut_pageBackground">@color/black</item>

        <!-- 文章內文配色預設值 -->
        <item name="bahamut_articleAuthorColor0">@color/article_page_text_item_author0</item>
        <item name="bahamut_articleContentColor0">@color/article_page_text_item_content0</item>
        <item name="bahamut_articleAuthorColor1">@color/article_page_text_item_author1</item>
        <item name="bahamut_articleContentColor1">@color/article_page_text_item_content1</item>
    </style>

    <style name="toolbar" parent="BaseTouchPart">
        <item name="android:orientation">horizontal</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="ToolbarDivider">
        <item name="android:background">?attr/bahamut_toolbarDivider</item>
        <item name="android:layout_width">1dp</item>
        <item name="android:layout_height">match_parent</item>
    </style>

    <style name="ToolbarItem" parent="BaseTouchPart">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">?attr/bahamut_buttonTextColor</item>
        <item name="android:background">?attr/bahamut_toolbarItemBackground</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:singleLine">true</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_weight">1</item>
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">2sp</item>
        <item name="autoSizeMaxTextSize">24sp</item>
        <item name="autoSizeStepGranularity">2sp</item>
    </style>

    <style name="ToolbarItem.Grid">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_marginRight">1dp</item>
        <item name="android:layout_marginBottom">1dp</item>
        <item name="android:layout_columnWeight">1</item>
    </style>

    <style name="ToolbarItem.Hero">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:padding">1dp</item>
        <item name="android:background">?attr/bahamut_pageBackground</item>
    </style>

    <style name="ToolbarItem.Danger">
        <item name="android:background">@drawable/button_background_1</item>
    </style>

    <style name="ToolbarItemLR" parent="ToolbarItem">
        <item name="android:layout_weight">9</item>
        <item name="android:visibility">gone</item>
        <item name="android:alpha">0.5</item>
        <item name="android:textColor">?attr/bahamut_dialogSelectArticleFocusedColor</item>
    </style>

    <style name="Block">
        <item name="android:paddingLeft">6dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingRight">6dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <style name="BlockDividerHorizontal">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">6dp</item>
    </style>

    <style name="Button">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/bahamut_buttonTextColor</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@android:drawable/list_selector_background</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
    </style>

    <style name="DialogSelectArticleHorizontalDivider">
        <item name="android:background">?attr/bahamut_dialogSelectArticleDividerColor</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:minHeight">1px</item>
    </style>

    <style name="DialogSelectArticleVerticalDivider">
        <item name="android:background">?attr/bahamut_dialogSelectArticleDividerColor</item>
        <item name="android:layout_width">1dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:minWidth">1px</item>
    </style>

    <style name="DialogToolbarItem" parent="BaseTouchPart">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">?attr/bahamut_buttonTextColor</item>
        <item name="android:background">?attr/bahamut_dialogItemBackground</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="Dialog_NoTitle_FullScreen">
        <item name="android:windowBackground">?attr/bahamut_pageBackground</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowContentOverlay">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <style name="EditTextSingleLine" parent="TextViewUltraLarge">
        <item name="android:textColor">?attr/bahamut_editTextColor</item>
        <item name="android:background">?attr/bahamut_editTextBackground</item>
        <item name="android:paddingLeft">6dp</item>
        <item name="android:paddingRight">6dp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="maxLines">1</item>
        <item name="singleLine">true</item>
    </style>

    <style name="ExtToolbar">
        <item name="android:orientation">horizontal</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="ToolbarItem.Ext">
        <item name="android:layout_width">match_parent</item>
    </style>

    <style name="HorizontalDivider">
        <item name="android:background">?attr/bahamut_dividerColor</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:minHeight">1px</item>
    </style>

    <style name="ItemViewDividerHorizontal">
        <item name="android:background">?attr/bahamut_listItemHorizontalDivider</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:minHeight">1px</item>
    </style>

    <style name="ItemViewDividerVertical">
        <item name="android:background">?attr/bahamut_listItemVerticalDivider</item>
        <item name="android:layout_width">1dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:minWidth">1px</item>
    </style>

    <style name="List">
        <item name="android:listSelector">@android:drawable/list_selector_background</item>
        <item name="android:divider">?attr/bahamut_dividerColor</item>
        <item name="android:dividerHeight">1dp</item>
    </style>

    <style name="ListDialogItem">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">?attr/bahamut_defaultTextColor</item>
        <item name="android:gravity">center</item>
        <item name="android:buttonTint">?attr/bahamut_checkboxTint</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:singleLine">true</item>
        <item name="android:layout_weight">1</item>
    </style>

    <style name="MainItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">?attr/bahamut_buttonTextColor</item>
    </style>

    <style name="MainItemBackground">
        <item name="android:background">?attr/bahamut_itemBackground</item>
    </style>

    <style name="MenuItem">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/bahamut_buttonTextColor</item>
        <item name="android:background">@android:drawable/list_selector_background</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="Dialog.NoTitleBar" parent="Theme.AppCompat.DayNight.Dialog">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="bahamut_defaultTextColor">@color/white</item>
        <item name="bahamut_buttonTextColor">@color/button_text_color</item>
        <item name="bahamut_titleBarBackground">#FF000060</item>
        <item name="bahamut_titleBarMenuIconBackground">#FF101090</item>
        <item name="bahamut_toolbarItemBackground">@drawable/toolbar_item_background_color</item>
        <item name="bahamut_dialogItemBackground">@drawable/dialog_item_background_color</item>
        <item name="bahamut_toolbarDivider">@color/black</item>
    </style>

    <style name="TextViewUltraLarge" parent="TextViewNormal">
        <item name="android:textSize">28sp</item>
    </style>

    <style name="TextViewLarge" parent="TextViewNormal">
        <item name="android:textSize">24sp</item>
    </style>

    <style name="TextViewNormal">
        <item name="android:textColor">?attr/bahamut_defaultTextColor</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="TextViewSmall" parent="TextViewNormal">
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextViewVerySmall" parent="TextViewNormal">
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TouchBlock">
        <item name="android:paddingLeft">6dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingRight">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
    </style>

    <style name="VerticalDivider">
        <item name="android:background">?attr/bahamut_dividerColor</item>
        <item name="android:layout_width">1dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:minWidth">1px</item>
    </style>

    <style name="SelectArticleItemL" parent="BaseTouchPart">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/bahamut_dialogSelectArticleTextColor</item>
        <item name="android:gravity">center</item>
        <item name="android:background">?attr/bahamut_dialogSelectArticleItemBackground</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">70dp</item>
    </style>

    <style name="SelectArticleItemP" parent="BaseTouchPart">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/bahamut_dialogSelectArticleTextColor</item>
        <item name="android:gravity">center</item>
        <item name="android:background">?attr/bahamut_dialogSelectArticleItemBackground</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">90dp</item>
        <item name="android:textSize">32sp</item>
    </style>

    <style name="SystemSettingsItem" parent="BaseTouchPart">
        <item name="android:background">@android:drawable/list_selector_background</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">5dp</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="CheckboxBahamut">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:buttonTint">?attr/bahamut_checkboxTint</item>
    </style>

    <style name="SystemSettingsCheckboxText" parent="TextViewLarge">
        <item name="android:textColor">?attr/bahamut_defaultTextColor</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_centerVertical">true</item>
    </style>

    <style name="SystemSettingsCheckbox" parent="BaseTouchPart">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_centerVertical">true</item>
        <item name="android:layout_alignParentEnd">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:scaleX">1</item>
        <item name="android:scaleY">1</item>
        <item name="android:textColor">?attr/bahamut_defaultTextColor</item>
        <item name="android:buttonTint">?attr/bahamut_checkboxTint</item>
    </style>

    <style name="SystemSettingsSpinnerText" parent="TextViewLarge">
        <item name="android:textColor">?attr/bahamut_defaultTextColor</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_centerVertical">true</item>
    </style>

    <style name="SystemSettingsChapter" parent="TextViewLarge">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/bahamut_chapterTextColor</item>
        <item name="android:background">?attr/bahamut_chapterBackground</item>
        <item name="android:paddingStart">5dp</item>
    </style>

    <style name="SystemSettingsSpinnerItem" parent="SpinnerStyle">
        <item name="android:textColor">?attr/bahamut_defaultTextColor</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_centerVertical">true</item>
        <item name="android:layout_alignParentEnd">true</item>
        <item name="android:textSize">19sp</item>
    </style>

    <style name="SystemSettingsSlider" parent="SpinnerStyle">
        <item name="android:textColor">?attr/bahamut_defaultTextColor</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_centerVertical">true</item>
        <item name="android:layout_alignParentEnd">true</item>
        <item name="android:textSize">19sp</item>
        <item name="trackColorActive">?attr/bahamut_sliderActiveColor</item>
        <item name="thumbColor">?attr/bahamut_sliderThumbColor</item>
        <item name="trackColorInactive">?attr/bahamut_sliderInactiveColor</item>
    </style>

    <style name="SystemSettingsDirectoryText" parent="TextViewLarge">
        <item name="android:textColor">?attr/bahamut_defaultTextColor</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_centerVertical">true</item>
        <item name="android:layout_weight">1</item>
    </style>

    <style name="SpinnerStyle" parent="@style/Widget.AppCompat.Spinner">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:backgroundTint">?attr/bahamut_defaultTextColor</item>
        <item name="android:popupBackground">?attr/bahamut_pageBackground</item>
    </style>

    <style name="ToolbarItem.RightMenu">
        <item name="android:layout_width">0dp</item>
    </style>

    <style name="DialogQueryHeroText" parent="TextViewNormal">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="StartIcon">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:background">?attr/bahamut_itemBackground</item>
    </style>
</resources>
