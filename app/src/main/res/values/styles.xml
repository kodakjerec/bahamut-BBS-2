    <style name="toolbar" parent="BaseTouchPart">
        <item name="android:orientation">horizontal</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="ToolbarDivider">
        <item name="android:background">?attr/bahamut_toolbarDivider</item>
        <item name="android:layout_width">1dp</item>
        <item name="android:layout_height">match_parent</item>
    </style>

    <style name="ToolbarItem" parent="BaseTouchPart">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">?attr/bahamut_buttonTextColor</item>
        <item name="android:background">?attr/bahamut_toolbarItemBackground</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:singleLine">true</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_weight">1</item>
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">2sp</item>
        <item name="autoSizeMaxTextSize">24sp</item>
        <item name="autoSizeStepGranularity">2sp</item>
    </style>

    <style name="ToolbarItem.Grid">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_marginRight">1dp</item>
        <item name="android:layout_marginBottom">1dp</item>
        <item name="android:layout_columnWeight">1</item>
    </style>

    <style name="ToolbarItem.Hero">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:padding">1dp</item>
        <item name="android:background">?attr/bahamut_pageBackground</item>
    </style>

    <style name="ToolbarItem.Danger">
        <item name="android:background">?attr/bahamut_buttonDangerBackground</item>
        <item name="android:textColor">?attr/bahamut_buttonDangerTextColor</item>
    </style>

    <style name="ToolbarItemLR" parent="ToolbarItem">
        <item name="android:layout_weight">9</item>
        <item name="android:visibility">gone</item>
        <item name="android:alpha">0.5</item>
        <item name="android:textColor">?attr/bahamut_dialogSelectArticleFocusedColor</item>
    </style>

    <style name="Block">
        <item name="android:paddingLeft">6dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingRight">6dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <style name="BlockDividerHorizontal">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">6dp</item>
    </style>

    <style name="Button">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/bahamut_buttonTextColor</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@android:drawable/list_selector_background</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
    </style>

    <style name="DialogSelectArticleHorizontalDivider">
        <item name="android:background">?attr/bahamut_dialogSelectArticleDividerColor</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:minHeight">1px</item>
    </style>

    <style name="DialogSelectArticleVerticalDivider">
